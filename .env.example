# ====================================================================
# Utkal Finance - Backend Environment Variables Configuration
# ====================================================================

# Environment Mode (development / production)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Database Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/new-utkal-finance

# JWT Secret Key for Session Authentication & Token Signing
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

# Frontend Application URL (used in email links and CORS)
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (comma-separated list, optional)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://utkalfinance.netlify.app

# SMTP / Email Notification Configuration (Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password
EMAIL_FROM=New Utkal Finance Ltd. <your-email@gmail.com>
